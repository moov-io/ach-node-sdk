{
  "name": "ach-node-sdk",
  "version": "1.14.0",
  "description": "An HTTP client SDK for the moov-io/ach REST API, generated by openapi-generator",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "docs": "typedoc --out docs/ *.ts",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "keywords": [
    "openapi",
    "rest",
    "node",
    "sdk"
  ],
  "author": "Moov Inc",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.0.0",
    "tslib": "^2.3.0",
    "url": "^0.11.0"
  },
  "devDependencies": {
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "*.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  }
}
